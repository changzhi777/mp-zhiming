{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@zhiming/shared": ["vendor/zhiming/packages/shared/src/index.ts"],
      "@zhiming/shared/*": ["vendor/zhiming/packages/shared/src/*"],
      "@/*": ["src/*"]
    },
    "types": ["@tarojs/taro", "react", "react-dom", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "vendor/zhiming/packages/shared/src/**/*",
    "tests/**/*",
    "*.config.ts",
    "*.config.js"
  ],
  "exclude": ["node_modules", "dist", "vendor/zhiming/apps/**", "vendor/zhiming/scripts/**"]
}