{
  "name": "mp-zhiming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "知命主站精简版微信小程序 · M17 · Taro 3 + React 19 + Tailwind 4",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "taro build --type weapp --watch",
    "build": "taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "sync:shared": "git -C vendor/zhiming pull origin main",
    "ci": "pnpm sync:shared && pnpm install && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tarojs/components": "^3.6.0",
    "@tarojs/helper": "^3.6.0",
    "@tarojs/plugin-framework-react": "^3.6.0",
    "@tarojs/react": "^3.6.0",
    "@tarojs/runtime": "^3.6.0",
    "@tarojs/shared": "^3.6.0",
    "@tarojs/taro": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "@tarojs/postcss-tailwindcss-unit-transform": "^3.6.0",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}